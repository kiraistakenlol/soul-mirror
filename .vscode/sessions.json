{
    "$schema": "https://cdn.statically.io/gh/nguyenngoclongdev/cdn/main/schema/v11/terminal-keeper.json",
    "theme": "tribe",
    "active": "claude",
    "activateOnStartup": true,
    "keepExistingTerminals": false,
    "sessions": {
        "claude": [
            {
                "name": "Claude",
                "autoExecuteCommands": true,
                "icon": "robot",
                "color": "terminal.ansiCyan",
                "commands": [
                    "claude"
                ]
            },
            {
                "name": "Backend",
                "autoExecuteCommands": true,
                "icon": "server",
                "color": "terminal.ansiGreen",
                "commands": [
                    "cd apps/backend && ./scripts/dev.sh"
                ]
            },
            {
                "name": "Test Runner",
                "autoExecuteCommands": true,
                "icon": "beaker",
                "color": "terminal.ansiYellow",
                "commands": [
                    "cd apps/test-runner && ./scripts/dev.sh"
                ]
            },
            {
                "name": "Frontend",
                "autoExecuteCommands": true,
                "icon": "browser",
                "color": "terminal.ansiBlue",
                "commands": [
                    "cd apps/frontend && ./scripts/dev.sh"
                ]
            },
            {
                "name": "Telegram Bot",
                "autoExecuteCommands": true,
                "icon": "comment",
                "color": "terminal.ansiCyan",
                "commands": [
                    "cd apps/telegram-bot && ./scripts/dev.sh"
                ]
            },
            {
                "name": "VPS",
                "autoExecuteCommands": true,
                "icon": "vm",
                "color": "terminal.ansiMagenta",
                "commands": [
                    "ssh root@45.32.117.48"
                ]
            }
        ]
    }
}