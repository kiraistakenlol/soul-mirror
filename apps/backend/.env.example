# LLM Provider Configuration
# Options: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# API Keys (set the one matching your LLM_PROVIDER)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Database Configuration
DATABASE_URL=postgresql://soulmirror:soulmirror@localhost:5433/soulmirror

# Server Configuration
PORT=8080
ENVIRONMENT=development

# Telegram Bot Service
# Local: http://localhost:8082
# Docker: http://telegram-bot:8082
TELEGRAM_BOT_URL=http://localhost:8082