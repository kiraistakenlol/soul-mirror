# Soul Mirror Backend Configuration

# LLM Configuration
# Choose your LLM provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic API Key (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
# Server Configuration
PORT=8080
ENVIRONMENT=development

# Note: Copy this file to .env and fill in your actual values
# .env file is gitignored for security